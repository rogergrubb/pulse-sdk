{
  "name": "@mypulsecity/sdk",
  "version": "0.1.0",
  "description": "Real-time ambient geo-presence SDK — see your users from the horizon.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vanilla": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/three": "^0.162.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "~5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "keywords": [
    "geo",
    "presence",
    "realtime",
    "websocket",
    "three.js",
    "webgl",
    "location",
    "sdk",
    "pulse"
  ],
  "author": "Number One Son Software Development, LLC",
  "license": "MIT",
  "homepage": "https://mypulse.city",
  "repository": {
    "type": "git",
    "url": "https://mypulse.city"
  },
  "bugs": {
    "url": "https://mypulse.city"
  },
  "publishConfig": {
    "access": "public"
  }
}
